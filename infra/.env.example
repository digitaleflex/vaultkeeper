# Copiez ce fichier en `.env` (chmod 600) puis lancez `./init-secrets.sh`
# qui remplit automatiquement les secrets générés.
#
# ⚠️ INFISICAL_ENCRYPTION_KEY et INFISICAL_AUTH_SECRET doivent être conservés
#    AUSSI hors du serveur (kit de récupération papier / coffre Vaultwarden) :
#    sans eux, la sauvegarde Infisical est irrécupérable.

# Versions épinglées : vérifiez les dernières versions stables avant installation
#   https://github.com/dani-garcia/vaultwarden/releases
#   https://hub.docker.com/r/infisical/infisical/tags
VAULTWARDEN_VERSION=CHANGEME
INFISICAL_VERSION=CHANGEME

# Nom Tailscale du VPS, ex. vps-secrets.tail1234.ts.net
TS_HOSTNAME=CHANGEME.ts.net
VAULTWARDEN_URL=https://${TS_HOSTNAME}
INFISICAL_URL=https://${TS_HOSTNAME}:8443

# --- générés par init-secrets.sh ---
VAULTWARDEN_ADMIN_TOKEN=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
POSTGRES_PASSWORD=

# --- SMTP (optionnel mais recommandé pour les invitations d'équipe) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
